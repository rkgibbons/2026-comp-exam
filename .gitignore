# LaTeX build artifacts — all aux output is confined to per-folder .build/
# dirs by tools/build_all.py. The stray patterns below cover files produced
# by editors (Overleaf, TeXShop, VS Code) that don't use the builder.
.build/
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.fls
*.fdb_latexmk
*.blg
*.bbl
*.bcf
*.run.xml
*.lof
*.lot
*.nav
*.snm
*.vrb

# Generated compendium PDF (rebuild with tools/build_compendium.py --pdf)
Compendium/*.pdf

# macOS
.DS_Store

# R
.Rhistory
.RData
